#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-commit hook for React TypeScript boilerplate
echo "🧹 Running pre-commit checks..."

# Type check first (fastest)
echo "📋 Type checking..."
npx tsc --noEmit --skipLibCheck

if [ $? -ne 0 ]; then
  echo "❌ Type check failed. Please fix TypeScript errors before committing."
  exit 1
fi

# ESLint
echo "🔍 Running ESLint..."
npx eslint . --ext .ts,.tsx --max-warnings 0

if [ $? -ne 0 ]; then
  echo "❌ ESLint failed. Please fix linting errors before committing."
  exit 1
fi

# Prettier check (without auto-fixing)
echo "🎨 Checking code formatting..."
npx prettier --check .

if [ $? -ne 0 ]; then
  echo "❌ Prettier check failed. Run 'yarn format' to fix formatting issues."
  exit 1
fi

echo "✅ All pre-commit checks passed!"
