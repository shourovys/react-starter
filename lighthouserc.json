{
  "ci": {
    "collect": {
      "url": ["http://localhost:4173/", "http://localhost:4173/"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox",
        "staticDistDir": "./dist",
        "formFactor": "desktop",
        "screenEmulation": {
          "mobile": false,
          "disableDeviceEmulation": true
        },
        "emulatedUserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/119.0.0.0 Safari/537.36"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:pwa": ["warn", { "minScore": 0.5 }],

        "first-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 4000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "speed-index": ["error", { "maxNumericValue": 4000 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }],

        "server-response-time": ["warn", { "maxNumericValue": 1000 }],
        "mainthread-work-breakdown": ["warn", { "maxNumericValue": 250 }],
        "max-potential-fid": ["warn", { "maxNumericValue": 200 }],

        "resource-summary:script": ["warn", { "maxTransferSize": 300000 }],
        "resource-summary:image": ["warn", { "maxTransferSize": 500000 }],
        "resource-summary:font": ["warn", { "maxTransferSize": 100000 }],
        "resource-summary:document": ["warn", { "maxTransferSize": 50000 }],
        "resource-summary:stylesheet": ["warn", { "maxTransferSize": 100000 }],
        "resource-summary:media": ["warn", { "maxTransferSize": 1000000 }],
        "resource-summary:other": ["warn", { "maxTransferSize": 100000 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage",
      "outputDir": "./lighthouseci-results",
      "reportFilenamePattern": "%%PATHNAME%%-%%DATETIME%%.report.%%EXTENSION%%"
    }
  },
  "config": {
    "settings": {
      "budgetPath": "./budget.json",
      "chromeFlags": "--no-sandbox",
      "formFactor": "desktop",
      "screenEmulation": {
        "mobile": false,
        "disableDeviceEmulation": true
      },
      "emulatedUserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/119.0.0.0 Safari/537.36",
      "preset": "desktop"
    },
    "categories": {
      "performance": {
        "title": "Performance",
        "description": "These metrics assess page performance. [Learn more about the Performance category](https://web.dev/performance-scoring/).",
        "weight": 0.25
      },
      "accessibility": {
        "title": "Accessibility",
        "description": "These checks highlight opportunities to improve the accessibility of your web app. [Learn more about the Accessibility category](https://web.dev/accessibility-scoring/).",
        "weight": 0.25
      },
      "best-practices": {
        "title": "Best Practices",
        "description": "These checks ensure that your web app is following generally accepted best practices. [Learn more about the Best Practices category](https://web.dev/best-practices-scoring/).",
        "weight": 0.25
      },
      "seo": {
        "title": "SEO",
        "description": "These checks ensure that your page is following search engine optimization best practices. [Learn more about the SEO category](https://web.dev/seo-scoring/).",
        "weight": 0.25
      }
    },
    "audits": [
      "is-on-https",
      "redirects-http",
      "service-worker",
      "works-offline",
      "viewport",
      "without-javascript",
      "first-contentful-paint",
      "largest-contentful-paint",
      "first-meaningful-paint",
      "speed-index",
      "cumulative-layout-shift",
      "total-blocking-time",
      "server-response-time",
      "mainthread-work-breakdown",
      "max-potential-fid",
      "total-byte-weight",
      "unused-javascript",
      "unused-css-rules",
      "font-display",
      "uses-optimized-images",
      "uses-responsive-images",
      "uses-rel-preconnect",
      "uses-rel-preload",
      "uses-text-compression",
      "uses-rel-dns-prefetch",
      "resource-summary",
      "efficient-animated-content",
      "legacy-javascript",
      "preload-fonts",
      "preconnect-to-3rd-parties",
      "interactive",
      "bundle-size-budget"
    ]
  }
}
