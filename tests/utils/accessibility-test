import { render } from '@testing-library/react';

/**
 * Run accessibility tests on a React component
 */
export async function testComponentAccessibility(component: React.ReactElement) {
  const { container } = render(component);

  // Basic accessibility checks
  const checks = {
    hasMainHeading: !!container.querySelector('h1'),
    hasProperHeadingHierarchy: checkHeadingHierarchy(container),
    hasAltText: checkAltText(container),
    hasAriaLabels: checkAriaLabels(container),
    hasFocusableElements: checkFocusableElements(container),
  };

  return {
    checks,
    isAccessible: Object.values(checks).every(check => check),
  };
}

/**
 * Check heading hierarchy
 */
function checkHeadingHierarchy(container: HTMLElement): boolean {
  const headings = container.querySelectorAll('h1, h2, h3, h4, h5, h6');
  if (headings.length === 0) return true; // No headings is acceptable

  let previousLevel = 0;
  for (const heading of headings) {
    const level = parseInt(heading.tagName.charAt(1));
    if (level > previousLevel + 1) return false; // Skip levels
    previousLevel = level;
  }
  return true;
}

/**
 * Check for alt text on images
 */
function checkAltText(container: HTMLElement): boolean {
  const images = container.querySelectorAll('img');
  if (images.length === 0) return true; // No images is acceptable

  for (const img of images) {
    if (!img.hasAttribute('alt')) return false;
  }
  return true;
}

/**
 * Check for proper ARIA labels
 */
function checkAriaLabels(container: HTMLElement): boolean {
  const interactiveElements = container.querySelectorAll('button, input, select, textarea, [role="button"], [role="textbox"]');

  for (const element of interactiveElements) {
    const hasLabel = element.hasAttribute('aria-label') ||
                    element.hasAttribute('aria-labelledby') ||
                    element.textContent?.trim();
    if (!hasLabel) return false;
  }
  return true;
}

/**
 * Check for focusable elements
 */
function checkFocusableElements(container: HTMLElement): boolean {
  const focusableSelectors = [
    'a[href]',
    'button',
    'input',
    'select',
    'textarea',
    '[tabindex]:not([tabindex="-1"])',
    '[role="button"]',
  ];

  const focusableElements = container.querySelectorAll(focusableSelectors.join(', '));
  return focusableElements.length > 0;
}

/**
 * Test screen reader compatibility
 */
export async function testScreenReaderCompatibility(component: React.ReactElement) {
  const { container } = render(component);

  // Check for proper ARIA labels
  const elementsWithAria = container.querySelectorAll('[aria-label], [aria-labelledby], [aria-describedby]');
  const missingAria = Array.from(container.querySelectorAll('button, input, select, textarea'))
    .filter(el => !el.hasAttribute('aria-label') && !el.getAttribute('aria-labelledby'));

  // Check for proper heading structure
  const headings = container.querySelectorAll('h1, h2, h3, h4, h5, h6');

  return {
    elementsWithAria: elementsWithAria.length,
    missingAria: missingAria.length,
    headingCount: headings.length,
    hasMainHeading: !!container.querySelector('h1'),
    isScreenReaderFriendly: missingAria.length === 0 && headings.length > 0,
  };
}

/**
 * Test keyboard navigation
 */
export async function testKeyboardNavigation(component: React.ReactElement) {
  const { container } = render(component);

  // Find all focusable elements
  const focusableElements = container.querySelectorAll(
    'a, button, input, select, textarea, [tabindex]:not([tabindex="-1"]), [role="button"]'
  ) as NodeListOf<HTMLElement>;

  return {
    focusableElements: focusableElements.length,
    hasFocusableElements: focusableElements.length > 0,
  };
}
