{
  "*.{ts,tsx}": ["eslint --fix", "prettier --write"],
  "*.{js,jsx}": ["eslint --fix", "prettier --write"],
  "*.{json,md,css,html}": ["prettier --write"],
  "src/**/*.{test,spec}.{ts,tsx}": ["eslint --fix", "prettier --write"],
